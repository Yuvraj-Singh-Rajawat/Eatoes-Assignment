// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  cart      Cart?
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           Json[]
  total           Float
  status          Status      @default(PENDING)
  paymentId       String?
  paymentState    String?
  deliveryAddress String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  customerId      String?     // Changed to String to match the Customer.id type
  OrderItem       OrderItem[]
  // Removed Customer relation to avoid circular reference
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  items     Json[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Float
  category    String
  image       String?
  available   Boolean     @default(true)
  ingredients String[]
  allergens   String[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  orderItems  OrderItem[]

  @@map("menu_items")
}

model Customer {
  id        String    @id @default(uuid()) // Changed to String type for consistency
  name      String
  phone     String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  orders    Order[]   // Keep this relation

  @@map("restaurant_customers")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Float
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("order_items")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}